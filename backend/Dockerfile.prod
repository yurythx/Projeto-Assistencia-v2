# ==============================================================================
# Dockerfile de Produção — Backend Go (Projeto Nexus)
# Imagem estática multi-stage otimizada (~15MB), execução como usuário não-root.
# ==============================================================================

# --- Estágio 1: Build ---
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Dependências do sistema para CGO/Certificados
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Compilação estática do binário da API
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /app/api-server ./cmd/api

# --- Estágio 2: Runtime Minimalista ---
FROM alpine:3.20 AS runner

WORKDIR /app

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /app/api-server /app/api-server
COPY --from=builder /app/docs /app/docs

USER appuser

EXPOSE 8002

ENV PORT=8002
ENV TZ=America/Cuiaba

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8002/ready || exit 1

CMD ["/app/api-server"]
