# Segredos deste arquivo: valores de placeholder, funcionais em dev local
# (docker compose não se importa que "pareçam" um segredo de exemplo), mas
# PÚBLICOS por definição — este arquivo é commitado no git. `config.Load()`
# recusa subir em APP_ENV=production se DB_PASSWORD/RABBITMQ_DEFAULT_PASS
# ainda estiverem nestes valores literais (ver
# backend/internal/platform/config/config.go); gere valores reais antes de
# qualquer ambiente que não seja seu laptop (ex.: `openssl rand -hex 32`).
# Num servidor, `scripts/deploy.sh` gera o .env com segredos fortes (ver
# docs/DEPLOY.md).

# Ambiente: development | staging | production. O docker-compose.yml usa
# production quando vazio; o docker-compose.dev.yml força development.
APP_ENV=development

# Portas publicadas no host e URLs vistas pelo NAVEGADOR. Em servidor,
# troque localhost pelo IP/DNS da máquina. As NEXT_PUBLIC_* do frontend são
# derivadas destas e embutidas no BUILD — mudou aqui, rebuild do frontend.
# HOST_BIND: interface das portas publicadas acima. Com o proxy HTTPS
# (scripts/enable-https.sh) vira 127.0.0.1 — o Caddy é a única entrada.
HOST_BIND=0.0.0.0
FRONTEND_PORT=3002
HTTP_PORT=8002
HOST_MINIO_PORT=9002
HOST_MINIO_CONSOLE_PORT=9003
FRONTEND_URL=http://localhost:3002
API_PUBLIC_URL=http://localhost:8002
WEBSOCKET_PUBLIC_URL=ws://localhost:8002/ws

# Banco de Dados
DB_USER=nexus
DB_PASSWORD=dev-change-this-db-password
DB_NAME=nexus
DB_PORT=5432

# Mensageria / Filas
RABBITMQ_DEFAULT_USER=nexus
RABBITMQ_DEFAULT_PASS=dev-change-this-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=nexus

# Redis (cache de permissões, rate limit, lockout, idempotência)
REDIS_PASSWORD=dev-change-this-redis-password

# Keycloak / Auth OIDC
# KEYCLOAK_ISSUER_URL vazio = só login local. É o "iss" dos tokens: API e
# frontend usam a MESMA URL pública (ex.: https://<host>:8543/realms/nexus).
KEYCLOAK_ISSUER_URL=
KEYCLOAK_REALM=nexus
# Client nexus-backend: audience dos tokens E reautenticação do Signum
# (grant password na hora de assinar) — confidencial, só Direct Access
# Grants. Sem o secret, ninguém assina com conta do Keycloak.
KEYCLOAK_CLIENT_ID=nexus-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=nexus-backend
KEYCLOAK_FRONTEND_CLIENT_ID=nexus-frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=dev-change-this-keycloak-client-secret

# Autenticacao Local / Backend & NextAuth
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_PRIVATE_KEY_FILE=/run/secrets/local_auth_private_key.pem
# NEXTAUTH_SECRET assina o cookie de sessão do frontend — gere com
# `openssl rand -hex 32` antes de qualquer ambiente real.
NEXTAUTH_SECRET=dev-change-this-nextauth-secret

# CONFIG_ENCRYPTION_KEY cifra (AES-256-GCM) segredos que o menu
# Configurações > Keycloak grava no Postgres em tempo de execução (ver
# backend/internal/platform/secretcrypto e keycloakconfig) — sem ela, o
# backend recusa iniciar em produção (config.Load). Precisa decodificar,
# em base64 padrão, para exatamente 32 bytes: gere com
# `openssl rand -base64 32` antes de qualquer ambiente real; NUNCA rotacione
# sem primeiro resalvar a configuração do Keycloak pela tela (uma chave
# trocada torna o segredo já persistido indecifrável).
CONFIG_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Object Storage (MinIO)
MINIO_ROOT_USER=nexus_minio_admin
MINIO_ROOT_PASSWORD=dev-change-this-minio-password
MINIO_BUCKET=nexus
# Endereço do MinIO visto pelo NAVEGADOR (URLs pré-assinadas de upload e
# download). Com o docker-compose.dev.yml o MinIO é publicado na porta 9002
# do host — com 9000 aqui, todo envio/baixa de arquivo falhava no navegador.
MINIO_PUBLIC_URL=http://localhost:9002

# --- Conformidade / Hardening (roadmap de conformidade governamental) ---

# METRICS_SCRAPE_TOKEN (gap G-02): quando definido, GET /metrics exige
# "Authorization: Bearer <token>". Vazio = endpoint aberto (só aceitável
# em dev ou com a porta de métricas em rede interna isolada). Em produção,
# defina um valor forte (`openssl rand -hex 32`) e configure o mesmo no
# scrape do Prometheus. Suporta METRICS_SCRAPE_TOKEN_FILE.
METRICS_SCRAPE_TOKEN=

# TRUSTED_PROXIES (gap G-04): lista de CIDRs (separados por vírgula) dos
# proxies reversos à frente da API. Só quando a conexão TCP vem de uma
# dessas faixas é que o X-Forwarded-For é lido para descobrir o IP real
# do cliente (rate limiter e prova de consentimento LGPD). Vazio = nunca
# confiar em XFF. Ex.: TRUSTED_PROXIES=10.0.0.0/8,172.18.0.0/16
TRUSTED_PROXIES=

# API_RATE_LIMIT_* (gap G-01): teto por identidade autenticada (fallback:
# IP) aplicado a todo o grupo /api/v1. Default: 600 requisições / 60s.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=600

# LOGIN_LOCKOUT_IP_THRESHOLD: falhas de login LOCAL por IP antes do
# bloqueio progressivo do IP (a conta bloqueia com 5, até 24h). Alto de
# propósito: atrás de NAT um IP é um prédio inteiro. Bloqueio do IP: 1min
# dobrando até 1h; contador expira em 1h.
LOGIN_LOCKOUT_IP_THRESHOLD=30

# TRUST_PROXY_HEADERS (frontend): repassar o X-Forwarded-For do visitante à
# API. Só "true" com um proxy de borda que o sobrescreve na frente (o
# docker-compose.https.yml liga sozinho) — sem proxy o cabeçalho é forjável.
# TRUST_PROXY_HEADERS=true

# AUDIT_WORM_* (F2.6): cópia imutável diária da trilha de auditoria. O
# worker cria AUDIT_WORM_BUCKET com S3 Object Lock (bucket DEDICADO — o
# lock só pode ser habilitado na criação) e aplica retenção Compliance de
# AUDIT_WORM_RETENTION_DAYS a cada objeto. Sem object-lock no provider, o
# worker cai para escrita comum e a cadeia de SHA-256 segue como evidência.
AUDIT_WORM_BUCKET=nexus-audit-worm
AUDIT_WORM_RETENTION_DAYS=1825

# Atlas — assistente (fluxos e TTDD). A IA é configurada pela tela
# (Configurações > Inteligência artificial — ADR 020); estas variáveis só
# valem enquanto nada for salvo lá. Vazio = sem IA (síntese canônica). Com
# IA: URL base de um serviço compatível com a API de chat da OpenAI. O
# overlay docker-compose.ia.yml (Ollama, serviço ia-local) define o
# endereço sozinho; IA_LOCAL_MODELO, IA_LOCAL_MEMORIA, IA_LOCAL_CPUS e
# IA_LOCAL_TIMEOUT o ajustam.
# ATLAS_AI_ENDPOINT=
# ATLAS_AI_API_KEY=
# ATLAS_AI_MODEL=qwen2.5:1.5b
# ATLAS_AI_TIMEOUT=20s
# Consultas ao assistente por pessoa (janela fixa).
# ATLAS_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# ATLAS_CHAT_RATE_LIMIT_MAX=10

